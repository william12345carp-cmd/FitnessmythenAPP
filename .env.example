# ============================================================================
# Fitnessmythen — Frontend-Umgebung (Vite).
# Kopie als .env.local anlegen (gitignored). Leere Supabase-Werte = Mock-Modus.
# ============================================================================

# Supabase → Project Settings → API (Anon Key ist öffentlich, RLS schützt die Daten):
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# "true" = DEV-Panel (Zeitsimulation) auch im Production-Build zeigen —
# gedacht für Vercel-Preview-/Staging-Deploys, NIE für Production:
VITE_ENABLE_DEV_PANEL=

# Derzeit ungenutzt: Hosted Checkout läuft per Redirect ohne Stripe.js im Frontend.
VITE_STRIPE_PUBLISHABLE_KEY=

# Noch nicht angebunden (Entscheidung liegt beim Gründer):
VITE_ANALYTICS_KEY=
VITE_PUSH_PUBLIC_KEY=

# ============================================================================
# NICHT im Frontend! Secrets der Supabase Edge Functions — setzen mit:
#   supabase secrets set STRIPE_SECRET_KEY=sk_... STRIPE_WEBHOOK_SECRET=whsec_... \
#     STRIPE_PRICE_ID=price_... APP_URL=https://<produktions-domain>
#
#   STRIPE_SECRET_KEY      Stripe → Developers → API keys (Secret)
#   STRIPE_WEBHOOK_SECRET  Stripe → Developers → Webhooks → Signing secret
#   STRIPE_PRICE_ID        Stripe → Product Catalog → Preis (150 €/Monat) — nie hardcoden (§9.3)
#   APP_URL                Produktions-URL für Checkout-/Portal-Redirects
# ============================================================================
